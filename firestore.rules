rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    }
    function isResponder() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'responder';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isResponder() || isAdmin());
      allow create: if signedIn();
      // Users may update their own profile; only admins may change status/role.
      allow update: if signedIn() &&
        ((request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'profilePhotoUrl', 'fcmToken', 'tokenUpdatedAt', 'lastLogin', 'notificationPreferences'])) ||
         isAdmin());
      allow delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() &&
        ((isResponder() || isAdmin()) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'assignedResponderId', 'assignedResponderName', 'resolvedAt']) ||
         request.resource.data.reporterId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['description', 'category', 'subCategory', 'location', 'locationLabel', 'photoUrls', 'updatedAt', 'priority', 'aiSuggestion']));
      allow delete: if signedIn() && resource.data.reporterId == request.auth.uid;
    }

    match /sos_alerts/{sosId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isResponder() || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isResponder() || isAdmin());
      allow delete: if false;
    }

    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if false;   // created by Cloud Functions
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt', 'deliveryStatus', 'resendRequestedAt']);
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /trusted_contacts/{contactId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /community_alerts/{alertId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Live GPS trail for an active SOS. Written by the person in distress,
    // readable by responders and administrators tracking the alert.
    match /sos_locations/{pinId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Safe check-in / live journey tracking.
    match /check_ins/{checkInId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isResponder() || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['waypoints', 'updatedAt', 'status', 'completedAt']);
      allow delete: if isAdmin();
    }

    // User-defined geofenced safety zones.
    match /safety_zones/{zoneId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Responder live location while broadcasting.
    match /responder_locations/{responderId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == responderId;
      allow delete: if signedIn() && request.auth.uid == responderId;
    }

    // Static emergency facilities around Kakoba.
    match /emergency_resources/{resourceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Public community commentary attached to an incident.
    match /community_reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['verified']);
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // Audit trail of every incident-update action.
    match /incident_updates/{updateId} {
      allow read: if signedIn() &&
        (isResponder() || isAdmin() || resource.data.actorId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Audit log of AI classification requests and responses (admin only).
    match /ai_classification_log/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;   // written by Cloud Functions
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}